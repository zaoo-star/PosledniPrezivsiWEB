        "lastAttempt": {},
        "lastTarget": {}
      },
      "mayorRewards": {
        ".indexOn": [
          "timestamp",
          "mayor",
          "date"
        ]
      },
      "lastElectionResults": {
        ".indexOn": [
          "timestamp"
        ]
      },
      "lastAnnouncedPhase": {},
      "lastEvaluatedCycle": {},
      "lastTax": {},
      "locked": {},
      "mayorLastPayout": {},
      "mayorPassword": {}
    },
    "mayorTaxRecords": {
      ".read": true,
      ".write": true,
      "$taxId": {
        ".indexOn": [
          "paidAt",
          "player"
        ]
      }
    },
    "mayorTaxLocks": {
      ".read": true,
      ".write": true
    },
    "mayorTaxBans": {
      ".read": true,
      ".write": true,
      "$playerName": {
        ".indexOn": [
          "bannedAt",
          "until",
          "banType"
        ]
      }
    },
    "clans": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "leader",
        "createdAt",
        "name"
      ],
      "$locationId": {
        ".indexOn": [
          "leader",
          "createdAt",
          "level"
        ],
        "members": {
          "$memberKey": {
            ".indexOn": [
              "joinedAt",
              "rank"
            ]
          }
        },
        "officers": {
          "$officerKey": {
            ".indexOn": [
              "promotedAt",
              "rank"
            ]
          }
        },
        "buildings": {
          "$buildingId": {
            ".indexOn": [
              "builtAt"
            ]
          }
        },
        "buildQueue": {
          "$buildingId": {
            ".indexOn": [
              "startedAt",
              "finishAt"
            ]
          }
        },
        "clanStorage": {
          ".indexOn": [
            "depositedAt"
          ]
        },
        "vault": {},
        "vaultLog": {
          ".indexOn": [
            "timestamp",
            "type",
            "player"
          ]
        },
        "vaultWithdrawTracking": {
          "$date": {}
        },
        "activity": {
          ".indexOn": [
            "timestamp",
            "type",
            "player"
          ]
        },
        "activityLog": {
          ".indexOn": [
            "timestamp",
            "type",
            "player"
          ]
        },
        "dungeon": {
          ".indexOn": [
            "monsterPool",
            "minLevel"
          ]
        }
      }
    },
    "clanChat": {
      ".read": true,
      ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
      "$clanId": {
        "messages": {
          ".indexOn": [
            "timestamp"
          ]
        },
        ".write": true
      }
    },
    "worldBossLog": {
      ".read": true,
      ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
      ".indexOn": [
        "defeatedAt",
        "bossId",
        "locationId"
      ],
      "$id": {
        ".write": true
      }
    },
    "privateMessages": {
      ".read": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || root.child('staffUIDs').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
      ".indexOn": [
        "timestamp",
        "to",
        "from",
        "read"
      ],
      "$id": {
        ".write": true
      }
    },
    "globalWeather": {
      ".read": true,
      ".write": true
    },
    "publicMoney": {
      ".read": true,
      ".write": true
    },
    "mayorPriority": {
      ".read": true,
      ".write": true
    },
    "mayorInvestments": {
      ".read": true,
      ".write": true,
      "active": {
        ".indexOn": [
          "startTime",
          "finishTime",
          "startedBy"
        ]
      },
      "completed": {
        ".indexOn": [
          "finishedAt",
          "startedBy"
        ]
      },
      "history": {
        ".indexOn": [
          "investedAt",
          "projectId",
          "investedBy"
        ]
      },
      "totals": {}
    },
    "poker": {
      ".read": true,
      ".write": true
    },
    "pokerTables": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "lastActivity",
        "state",
        "blindLevel",
        "createdAt"
      ],
      "$tableId": {
        "players": {
          "$playerName": {
            ".indexOn": [
              "seat",
              "joinedAt"
            ]
          }
        }
      }
    },
    "pokerHands": {
      "$tableId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$playerName": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "pokerPayouts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$playerName": {
        ".indexOn": [
          "ts"
        ]
      }
    },
    "pokerStats": {
      ".read": true,
      ".write": "auth != null"
    },
    "scheduledRaids": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "attackerLeader",
        "attackerClanLocId",
        "defenderClanLocId",
        "scheduledTime",
        "status",
        "isDuel"
      ],
      "$raidId": {
        "pvpActionQueue": {
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "systemLocks": {
      ".read": true,
      ".write": "auth != null"
    },
    "clanRaidLog": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pvpStats": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "pvpElo",
        "pvpWins"
      ]
    },
    "pvpDuelCooldowns": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "adminUIDs": {
      ".read": false,
      ".write": false
    },
    "staffUIDs": {
      ".read": false,
      ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true"
    }
  }
}