        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('odid').val() === auth.uid || data.child('uid').val() === auth.uid || (auth != null && root.child('adminUIDs').child(auth.uid).val() === true))",
        ".validate": "!newData.exists() || newData.child('odid').val() === auth.uid || newData.child('uid').val() === auth.uid || (auth != null && root.child('adminUIDs').child(auth.uid).val() === true)"
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "cloudSaves": {
      "$key": {
        ".read": "$key === auth.uid || $key === auth.uid + '_history'",
        ".write": "$key === auth.uid || $key === auth.uid + '_history'"
      }
