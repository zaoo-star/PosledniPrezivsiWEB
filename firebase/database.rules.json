{
  "rules": {
    "stats": {
      ".read": true,
      ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
      "visits": {
        ".write": true,
        ".validate": "newData.isNumber() && (!data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 1))"
      },
      "$other": {
        ".write": true
      }
    },
    "forum": {
      ".read": true,
      ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
      "topics": {
        ".indexOn": [
          "category",
          "createdAt",
          "pinned"
        ],
        ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
        "$id": {
          ".write": true
        }
      },
      "posts": {
        ".indexOn": [
          "topicId",
          "createdAt"
        ],
        ".write": "auth != null && root.child('adminUIDs').child(auth.uid).val() === true",
        "$id": {
          ".write": true
        }
      },
      "$id": {
        ".write": true
      }
    },
    "reviews": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "rating"
      ],
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
